// El Rincón de Charly — Prisma schema (Neon PostgreSQL)
//
// Migrated off Supabase (Postgres/Auth/Realtime) to Neon + NextAuth + Prisma,
// matching the stack used by the other apps. Auth is now server-session based
// (NextAuth); authorization lives in server actions, not Postgres RLS.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NextAuth models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User is the identity (replaces Supabase auth.users + the old `profiles` table:
// username/avatarUrl now live here).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash for the credentials provider
  username      String?   @unique
  avatarUrl     String?

  accounts Account[]
  sessions Session[]

  gameStats      GameStats[]
  wallet         Wallet?
  roomsAsPlayer1 GameRoom[]  @relation("Player1")
  roomsAsPlayer2 GameRoom[]  @relation("Player2")
  plinkoSeed     PlinkoSeed?
  plinkoRounds   PlinkoRound[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Game models
// ============================================

model GameStats {
  id             String   @id @default(cuid())
  userId         String
  gameType       String
  gamesPlayed    Int      @default(0)
  gamesWon       Int      @default(0)
  gamesLost      Int      @default(0)
  gamesDraw      Int      @default(0)
  winStreak      Int      @default(0)
  bestWinStreak  Int      @default(0)
  totalPlayTime  Int      @default(0)
  byOpponent     Json?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, gameType])
  @@index([userId])
  @@index([gameType])
}

model GameRoom {
  id                 String   @id @default(cuid())
  gameType           String   @default("tic-tac-toe")
  status             String   @default("waiting") // waiting | playing | finished
  player1Id          String?
  player2Id          String?
  currentTurn        String?
  board              Json     @default("[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"]")
  winnerId           String?
  isDraw             Boolean  @default(false)
  isPrivate          Boolean  @default(false)
  rematchRequestedBy String?
  rematchRoomId      String?
  metadata           Json?
  player1            User?    @relation("Player1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2            User?    @relation("Player2", fields: [player2Id], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, gameType])
  @@index([gameType, status, isPrivate, player2Id])
}

// ============================================
// Wallet models (virtual credits)
// ============================================

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @default(1000.00) @db.Decimal(15, 2)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  type         String   // deposit | withdraw | bet | win | bonus | refund
  amount       Decimal  @db.Decimal(15, 2)
  balanceAfter Decimal  @db.Decimal(15, 2)
  description  String?
  gameSlug     String?
  metadata     Json?
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
}

// Idempotency ledger: a bet is paid out / refunded at most once per (room, player).
model BetSettlement {
  roomId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([roomId, userId])
}

// Server-authoritative stake ledger for PvP bets. When both players commit to an
// agreed amount, each player's stake is debited and recorded here IN THE SAME
// transaction that flips the room to agreed/playing. settleBetAction computes the
// payout from the SUM of these rows (never from client-supplied metadata), so a
// client cannot mint money by skipping its own debit. One stake per (room, player).
model BetStake {
  roomId    String
  userId    String
  amount    Decimal  @db.Decimal(15, 2)
  settled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([roomId, userId])
  @@index([roomId])
}

// Idempotency ledger for the daily bonus: at most one claim per user per AR-local
// day. The unique (userId, bonusDate) id turns the check-then-act race into a
// single atomic insert — a duplicate claim hits the primary-key constraint and
// aborts the crediting transaction.
model DailyBonus {
  userId    String
  bonusDate String   // AR-local calendar day, "YYYY-MM-DD"
  createdAt DateTime @default(now())

  @@id([userId, bonusDate])
}

// ============================================
// Plinko provably-fair (single-player)
// ============================================

// The active commit-reveal seed pair for a user. Each Plinko drop derives its
// path from HMAC-SHA256(serverSeed, `${clientSeed}:${nonce}`); the server only
// exposes serverSeedHash (a commitment) until the seed is rotated and revealed,
// letting the player verify past rounds. `nonce` increments once per drop.
model PlinkoSeed {
  userId         String   @id
  serverSeed     String   // secret until rotated/revealed
  serverSeedHash String   // SHA-256(serverSeed), shown to the player up front
  clientSeed     String
  nonce          Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One recorded Plinko drop. The outcome (path/slot/multiplier/winAmount) is
// derived server-side; the row keeps the commitment + inputs so the player can
// verify it after the seed is revealed.
model PlinkoRound {
  id             String   @id @default(cuid())
  userId         String
  betAmount      Decimal  @db.Decimal(15, 2)
  rows           Int
  serverSeedHash String
  clientSeed     String
  nonce          Int
  path           String   // e.g. "0110..." (0=left, 1=right), one char per row
  slot           Int
  multiplier     Decimal  @db.Decimal(10, 4)
  winAmount      Decimal  @db.Decimal(15, 2)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId])
}
