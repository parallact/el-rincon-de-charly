# Database — Neon (PostgreSQL). Use the POOLED connection string.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Ably (realtime for online multiplayer over websockets). Server-only.
# Without it the app falls back to polling. Get a key at ably.com (free tier).
ABLY_API_KEY=""
